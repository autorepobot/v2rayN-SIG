-    public static bool AreAllTunCoresPrivileged(string? currentCoreFile = null)
-    {
-        if (!Utils.IsLinux())
-        {
-            return false;
-        }
-
-        if (currentCoreFile.IsNotEmpty() && !IsCorePrivileged(currentCoreFile))
-        {
-            return false;
-        }
-
-        var cores = GetAllCoreExecFiles();
-        if (cores.Count == 0)
-        {
-            return false;
-        }
-
-        return cores.All(IsCorePrivileged);
-    }
